DATABASE_URL=postgresql://xiangqi_app:CHANGE_ME@localhost:5432/xiangqi_dev
# Random base64url secret of at least 32 bytes; generate locally, never commit real values.
AUTH_ACCESS_SECRET=GENERATE_A_RANDOM_LOCAL_SECRET
# Required HTTPS origin in production. Local default allows localhost/127.0.0.1:3000.
# AUTH_WEB_ORIGIN=https://game.example.com
# local: development mailbox only. Production requires smtp (no fallback).
OTP_MAIL_MODE=local
# Gmail SMTP: set OTP_MAIL_MODE=smtp in your ignored .env to send real mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM=your-sender@gmail.com
# Alternative: SMTP_PORT=587 and SMTP_SECURE=false (mandatory STARTTLS).
