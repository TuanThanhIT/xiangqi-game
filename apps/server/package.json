{
  "name": "@xiangqi/server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-dist.cjs && tsc",
    "start": "node dist/main.js",
    "test": "node scripts/test.cjs",
    "db:check": "ts-node src/db/check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm.cmd run db:check && drizzle-kit migrate",
    "db:verify": "ts-node src/db/verify-foundation.ts",
    "auth:fixture": "ts-node src/auth/login/fixture.ts",
    "test:auth": "npm.cmd run build && node scripts/test-auth.cjs",
    "otp:local": "ts-node src/auth/otp/delivery/otp-local.ts",
    "test:registration": "npm.cmd run build && node scripts/test-registration.cjs",
    "smtp:check": "ts-node src/auth/otp/delivery/smtp-check.ts",
    "test:wallet": "npm.cmd run build && node --test scripts/test-wallet.cjs",
    "test:reward": "npm.cmd run build && node --test scripts/test-reward.cjs",
    "test:check-in": "npm.cmd run build && node --test scripts/test-check-in.cjs",
    "test:items": "npm.cmd run build && node --test scripts/test-items.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/websockets": "12.3.2",
    "@xiangqi/rules": "*",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "3.1.14",
    "socket.io-client": "4.8.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
