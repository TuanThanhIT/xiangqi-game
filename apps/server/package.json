    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
